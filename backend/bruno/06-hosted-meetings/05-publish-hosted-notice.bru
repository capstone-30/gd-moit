meta {
  name: Publish hosted notice
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/hosted-meetings/{{hostedMeetingId}}/notices
  body: json
  auth: none
}

body:json {
  {
    "title": "Bruno 공지",
    "body": "활동 보고서를 제출해 주세요.",
    "documentRequirements": {
      "activity": true,
      "expenses": false
    }
  }
}

assert {
  res.status: eq 201
}
