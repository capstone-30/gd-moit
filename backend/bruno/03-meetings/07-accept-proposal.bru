meta {
  name: Accept proposal
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/meetings/{{meetingId}}/proposals/{{proposalId}}/acceptances/me
  body: json
  auth: none
}

headers {
  If-Match: {{meetingEtag}}
}

body:json {
  {}
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar("meetingEtag", res.getHeader("etag"));
  }
}

assert {
  res.status: eq 200
}
