meta {
  name: Confirm schedule
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/meetings/{{meetingId}}/confirmation
  body: json
  auth: none
}

headers {
  If-Match: {{meetingEtag}}
}

body:json {
  {
    "date": "{{date}}",
    "slot": {{slot}}
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar("meetingEtag", res.getHeader("etag"));
  }
}

assert {
  res.status: eq 200
}
