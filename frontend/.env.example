DATABASE_URL=postgresql://localhost/moit
# Production: provide the DB CA PEM and enable certificate verification.
DATABASE_CA=
APP_ORIGIN=http://localhost:3000
# At least 32 random characters; separate per environment.
AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# development only: messages written to a local test mailbox, never console
TEST_MAIL_DIR=
# Separate private delivery endpoint for deletion records; configure before opening registration.
DELETION_DELIVERY_URL=
DELETION_DELIVERY_TOKEN=

# Only for the designated operator CLI; exclude from the web service environment.
OPERATOR_ID=
AUDIT_DELIVERY_URL=
AUDIT_DELIVERY_TOKEN=
